{
  "name": "vnams-claudie",
  "productName": "vnam's Claudie",
  "version": "1.0.2",
  "private": true,
  "description": "vnam's Claudie: Claude Code com papéis de parede ASCII vivos, em português, inglês e vietnamita (baseado no Claudinho)",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "ascii-magic-art": "^1.1.0",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "author": {
    "name": "Luis Roberto",
    "url": "https://luisrobertoportifolio.com"
  },
  "homepage": "https://github.com/siinn1706/vnams-claudie",
  "build": {
    "appId": "com.vnam.claudie",
    "productName": "vnam's Claudie",
    "copyright": "Luis Roberto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icone.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vnam's Claudie",
      "artifactName": "vnams-Claudie-Setup.exe",
      "installerIcon": "src/icone.ico",
      "uninstallerIcon": "src/icone.ico",
      "uninstallDisplayName": "vnam's Claudie"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "siinn1706",
        "repo": "vnams-claudie",
        "releaseType": "release"
      }
    ]
  }
}
